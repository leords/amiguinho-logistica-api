# ==========================================
# Configurações do Servidor
# ==========================================
PORT=3334
NODE_ENV=development

# ==========================================
# Banco de Dados (PostgreSQL / Neon Serverless)
# ==========================================
# String de conexão do Neon (com pooling recomendado e sslmode=require)
DATABASE_URL="postgresql://usuario:senha@ep-exemplo-pooler.us-east-2.aws.neon.tech/amiguinho_logistica?sslmode=require"

# ==========================================
# Autenticação e Integração
# ==========================================
# Segredo JWT compartilhado com o ecossistema da Distribuidora Amigão
JWT_SECRET="sua_chave_secreta_jwt_compartilhada"

# URL da API Central do ERP (node-amiguinho-central)
API_CENTRAL_URL="http://localhost:4000"
